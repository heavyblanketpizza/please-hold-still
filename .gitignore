# Data and model files never go in git (they live on the external drive).
# Leading "/" = only the folder at the repo root. A bare "data/" also matched
# the code folder src/please_hold_still/data/, which then silently never got committed.
/data/
*.nii
*.nii.gz
*.npy
*.pt
*.pth
/outputs/

# macOS
.DS_Store
._*
